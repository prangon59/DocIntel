# ==============================================================================
# AI Document Intelligence System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply your environment-specific credentials.
# All fields below are supported; leaving a field empty will fall back to its
# safe system default where available.
# ==============================================================================

# PostgreSQL 16 Database with pgvector
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# Redis Message Broker & State Cache
REDIS_PORT=
REDIS_URL=

# Google Gemini LLM & Embedding Settings
GEMINI_API_KEY=
LLM_MODEL=
GEMINI_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LLM_TIMEOUT_SECONDS=
LLM_MAX_REQUESTS_PER_MINUTE=
LLM_CONCURRENCY_LIMIT=
LLM_CACHE_DIR=

# Ingestion, Security & Storage
MAX_UPLOAD_MB=
UPLOAD_DIR=
APP_ENV=
DEBUG=

# Validation Thresholds
MATH_TOLERANCE=
CONFIDENCE_THRESHOLD=
OCR_FALLBACK_CHAR_THRESHOLD=

# Frontend Web Application
NEXT_PUBLIC_API_URL=
